# Copy to services/api/.env and fill in. Never commit real values.
COSTAR_KIT_DIR=
VEXCEL_API_KEY=
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
ANTHROPIC_API_KEY=
UNSTUCK_MODEL=claude-opus-5-5
DATABASE_URL=sqlite:///./unstuck.sqlite
# Seconds between scripted pipeline steps (0 for tests)
UNSTUCK_STEP_DELAY=0.5
# Finished screenings shown on the landing page (comma-separated audit ids, 2-3 is best). They become read-only;
# visitors open their own free copy. Leave empty to hide the row.
UNSTUCK_FEATURED_AUDITS=
